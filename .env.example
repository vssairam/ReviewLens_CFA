# Copy this file to .env and fill in your key. Never commit .env.

# Which AI company to use: "openai" (default) or "anthropic"
REVIEWLENS_PROVIDER=openai

# Only the key for the provider you chose is needed
OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: model names (defaults shown are for OpenAI)
REVIEWLENS_MODEL=gpt-4o-mini
REVIEWLENS_REPORT_MODEL=gpt-4o

# Optional: speed / reliability
REVIEWLENS_MAX_CONCURRENCY=5
REVIEWLENS_MAX_RETRIES=2

# Reply language: "same" = reply in the language the customer used (default), "english" = always English
REVIEWLENS_REPLY_LANGUAGE=same

# Monday e-mail report (only needed for send_weekly_report.py)
# Gmail/Outlook need an "app password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
REPORT_FROM=you@example.com
REPORT_TO=manager@example.com,owner@example.com
